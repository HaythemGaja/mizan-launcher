<?xml version="1.0" encoding="utf-8"?>
<!-- SKELETON MANIFEST — Phase 2A foundation.
     Component names, permissions, features, queries and the
     accessibility configs mirror the v3.9 reference manifest
     (package com.mizan.launcher, display name "Sreeb", minSdk 26,
     targetSdk 34, versionCode 33 / versionName 3.10).
     Root-layer classes live in .app.* (see app/App.kt note); UI
     activities in .ui.*. The classes themselves land with the
     app/ui workers — aapt2 link tolerates missing classes, but
     NO APK from this skeleton is shippable until every component
     below exists. Later workers fill this file in; do not drop a
     component silently. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Best-effort Continue Watching: guarded at runtime, row hides without it. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Speed Up: signals OTHER apps' background processes to exit. Normal permission. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- v3.7 one-time tracker import only; after the import flag is set,
         NO code path queries the tracker provider again. -->
    <uses-permission android:name="com.haythem.tvtracker.permission.LAUNCHER_READ" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <queries>
        <package android:name="com.haythem.tvtracker" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
    </queries>

    <!-- Cleartext HTTP permitted app-wide (deliberate: Xtream panels,
         M3U, XMLTV are overwhelmingly plain http://host:port). -->
    <application
        android:name=".app.App"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Mizan">

        <!-- Home: singleTask, clearTaskOnLaunch, excludeFromRecents, stateNotNeeded. -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".ui.AllAppsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".ui.ForecastActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <!-- Phase 2D: FolderViewActivity exists in ui/ (folder open
             view) but was missing from the skeleton manifest; without
             this entry opening a folder would crash. -->
        <activity
            android:name=".ui.FolderViewActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".ui.SearchActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".ui.LibraryActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".ui.DetailsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".ui.TmdbSearchActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".ui.IptvActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".ui.IptvGuideActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />

        <!-- Passive notification listener: authorizes MediaSessionManager
             queries only; reads NO notification content; NOT a foreground service. -->
        <service
            android:name=".app.NowPlayingListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name=".app.MizanDreamService"
            android:exported="true"
            android:label="@string/app_name"
            android:description="@string/dream_desc"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- "Sreeb launcher watcher": window-state events only,
             canRetrieveWindowContent=false. Off by default. -->
        <service
            android:name=".app.WatcherService"
            android:exported="true"
            android:label="@string/watcher_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/watcher_config" />
        </service>

        <!-- "Sreeb launcher": global actions only, no gestures, no content.
             Off by default; no in-app toggle. -->
        <service
            android:name=".app.LauncherService"
            android:exported="true"
            android:label="@string/launcher_access_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/launcher_config" />
        </service>

        <receiver
            android:name=".app.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
