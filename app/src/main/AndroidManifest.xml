<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Best-effort Continue Watching: guarded at runtime, row hides without it. -->
    <uses-permission android:name="android.permission.READ_TV_LISTINGS" />
    <!-- Speed up (v1.4, now in Settings → Home & launcher): lets Mizan
         signal OTHER apps' background processes to exit. Normal
         (non-dangerous) permission; it cannot kill foreground
         processes and disables nothing. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Tracker view (v1.8): read TVShowsMoviesTracker's launcher sync
         snapshots. Normal-level permission declared by the tracker;
         granted at install, no runtime prompt. -->
    <uses-permission android:name="com.haythem.tvtracker.permission.LAUNCHER_READ" />

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Package visibility for the TV app list. -->
    <queries>
        <!-- Tracker view (v1.8): the sync provider + installed checks. -->
        <package android:name="com.haythem.tvtracker" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- v2.3.1: cleartext HTTP is permitted app-wide. Deliberate: this
         is a personal IPTV launcher and Xtream panels, M3U playlists
         and XMLTV feeds are overwhelmingly plain http://host:port —
         targetSdk 34 blocks cleartext by default, which silently
         killed every IPTV fetch (the server "not answering"). No
         credentials or personal data leave the device over it beyond
         what the user's own IPTV account already sends to his own
         server. (Diagnostics photo, 2026-10-22; spec §22.) -->
    <application
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:theme="@style/Theme.Mizan">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- v1.5: full-screen All Apps tab (status bar's ▦ All Apps tile). -->
        <activity
            android:name=".ui.AllAppsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- v1.4: full-screen weather forecast (OK on the weather widget). -->
        <activity
            android:name=".ui.ForecastActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- v1.4: app Search screen (Search tile / remote Search key). -->
        <activity
            android:name=".ui.SearchActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- v2.1: the tracker inside the launcher — My Library grid,
             in-launcher title details, TMDB search + add. All fed by
             the tracker's sync bridge; no new permissions. -->
        <activity
            android:name=".ui.LibraryActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".ui.DetailsActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".ui.TmdbSearchActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />

        <!-- v2.2: the IPTV browser + programme guide + player (IPTV
             home style; Xtream + M3U sources). The player declares
             picture-in-picture (scope addition 4): Home during
             playback tries PiP; devices that refuse fall back to
             normal behaviour. All non-exported; no new permissions
             (INTERNET above covers the panel + streams). -->
        <activity
            android:name=".ui.IptvActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".ui.IptvGuideActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden" />
        <activity
            android:name=".ui.PlayerActivity"
            android:exported="false"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden" />

        <!-- v1.4 Now Playing: passive notification listener whose only
             job is to authorize MediaSessionManager session queries
             (data/NowPlayingData). It reads no notification content
             and is NOT a foreground service. -->
        <service
            android:name=".NowPlayingListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Screensaver. -->
        <service
            android:name=".MizanDreamService"
            android:exported="true"
            android:label="@string/app_name"
            android:description="@string/dream_desc"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Optional Home watcher. Disabled until the user enables it in
             system Accessibility settings. Window-state events only. -->
        <service
            android:name=".WatcherService"
            android:exported="true"
            android:label="@string/watcher_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/watcher_config" />
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
